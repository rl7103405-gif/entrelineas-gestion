rules_version = '2';

// =====================================================================
//  Entre Líneas — reglas de la app de gestión
// =====================================================================
//
//  Proyecto Firebase PROPIO, separado del personal de Roberto: aquí hay
//  datos de clientes de terceros (nombres y teléfonos). Si algún día el
//  negocio se entrega o se cobra aparte, se entrega este proyecto y no se
//  toca nada más.
//
//  Todo cuelga de /negocios/{negocioId}. Hoy solo existe 'entrelineas',
//  pero así la misma app le sirve a otro taller sin migrar un documento.
//
//  QUIÉN ENTRA: solo quien tenga documento en
//  /negocios/{id}/miembros/{suUid} con activo != false. Crear ese
//  documento es lo que da acceso; borrarlo o poner activo:false lo quita.
//
//  DOS LIBROS SON INMUTABLES: 'cobros' e 'invMovs'. Se pueden crear y
//  leer, nunca modificar ni borrar. Un error se corrige agregando un
//  movimiento contrario que referencia al original. Así el saldo de un
//  pedido y la existencia de un material siempre se pueden reconstruir, y
//  nadie puede "arreglar" el pasado sin dejar rastro. Es lo que evita que
//  el número que ve Gaby y el dinero que de verdad entró se separen.
//
//  OJO — "un aviso nunca bloquea" es regla de la INTERFAZ: que falte
//  material no impide capturar nada. Estas reglas sí bloquean, y deben:
//  son la única frontera real, porque la configuración de Firebase es
//  pública en un sitio de GitHub Pages.
//
//  [POR CONFIRMAR CON GABY] si Elita ('apoyo') debe ver el dinero. Hoy
//  los tres roles leen todo el negocio. Firestore no puede ocultar campos
//  sueltos en una lectura: si Elita no debe ver importes, los cobros y
//  gastos tendrían que vivir en documentos aparte y cambiar estas reglas.
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    match /negocios/{negocio} {

      // ── quién es quién ────────────────────────────────────────
      function miDoc() {
        return get(/databases/$(database)/documents/negocios/$(negocio)/miembros/$(request.auth.uid));
      }
      function esMiembro() {
        return request.auth != null
          && exists(/databases/$(database)/documents/negocios/$(negocio)/miembros/$(request.auth.uid))
          && miDoc().data.get('activo', true) == true;
      }
      function miRol() { return miDoc().data.get('rol', ''); }
      function esDuena() { return esMiembro() && miRol() == 'duena'; }
      // la dueña y la socia operan el dinero; 'apoyo' captura pedidos y tareas
      function operaDinero() { return esMiembro() && (miRol() == 'duena' || miRol() == 'socia'); }

      // ── validaciones de forma ─────────────────────────────────
      function montoValido(c) {
        return c is int && c > 0 && c < 100000000;   // hasta $1,000,000, en centavos
      }
      // Días válidos SEGÚN EL MES (rechaza 31 de febrero, 31 de abril, 30 de febrero). No es
      // un calendario completo: deja pasar el 29 de febrero de un año NO bisiesto, porque
      // estas reglas no saben calcular bisiestos — eso sí lo frena la app (esFechaValida()).
      // Probado contra 17 casos en test-logica.mjs, con ese único desacuerdo documentado.
      function fechaValida(f) {
        return f is string && f.matches('^[0-9]{4}-((0[13578]|1[02])-(0[1-9]|[12][0-9]|3[01])|(0[469]|11)-(0[1-9]|[12][0-9]|30)|02-(0[1-9]|1[0-9]|2[0-9]))$');
      }
      // Todo movimiento de dinero e inventario usa su opId como id del documento. Es lo que
      // vuelve idempotente un reintento: el mismo intento no puede crear dos documentos,
      // porque el segundo choca con el primero (y update está cerrado).
      function idempotente(id) {
        return request.resource.data.opId == id;
      }
      function cuentaValida(c) {
        return c is string && c.size() > 0 && c.size() <= 60;
      }
      // El id de una cuenta no cambia aunque le cambien el nombre: es lo que impide que
      // renombrar "Nu · Gaby" parta su saldo en dos. No se puede comprobar aquí que esté en
      // el catálogo (las reglas no recorren listas); eso lo hace la app al ofrecer solo las
      // cuentas que existen, y un id desconocido se muestra aparte en vez de perderse.
      function cuentaIdValido(id) {
        return id is string && id.matches('^c_[A-Za-z0-9]{1,32}$');
      }
      // En cobros y gastos el cuentaId es OPCIONAL (los movimientos viejos no lo tienen),
      // pero si viene tiene que tener forma: un cuentaId basura mandaría ese dinero a una
      // cuenta inventada al calcular el saldo.
      function cuentaIdOpcionalValido(d) {
        return !('cuentaId' in d) || cuentaIdValido(d.cuentaId);
      }
      // quien registra un movimiento de dinero no puede firmarlo como otra persona
      function firmadoPorMi(campo) {
        return request.resource.data.get(campo, '') == request.auth.uid;
      }
      // ── corregir el precio de un pedido, con rastro (7-sep-2026) ──
      // El pedido dice cuál es su corrección (`correccionOpId`) y aquí se busca ESE
      // documento: tiene que escribirse en la misma tanda, apuntar a este pedido y decir
      // exactamente los mismos números que quedan en el pedido. Así nadie puede escribir
      // una auditoría que cuente una cosa y un pedido que cuente otra.
      //
      // El opId además tiene que ser NUEVO: si se aceptara el mismo de la corrección
      // anterior, una segunda corrección se colgaría del rastro de la primera y el cambio
      // de hoy no quedaría registrado en ningún lado.
      //
      // Lo primero es que la auditoría sea NUEVA. `getAfter()` ve el estado posterior pero
      // no prueba que el documento se haya escrito en esta operación: sin esto, alguien
      // podía crear la auditoría hoy y usarla para un cambio de precio mañana, o reusar la
      // de un ida y vuelta $100 → $200 → $100. Hallazgo crítico de Codex, 7-sep-2026.
      // `!exists() && existsAfter()` sí lo prueba: no estaba antes y está después, así que
      // nació en esta misma tanda atómica.
      function correccionAuditada(pedidoId) {
        return request.resource.data.get('correccionOpId', '') is string
          && request.resource.data.get('correccionOpId', '').size() > 0
          && request.resource.data.get('correccionOpId', '') != resource.data.get('correccionOpId', '')
          && !exists(rutaAuditoria(request.resource.data.get('correccionOpId', '')))
          && existsAfter(rutaAuditoria(request.resource.data.get('correccionOpId', '')))
          && auditoriaCuadra(auditoria(request.resource.data.get('correccionOpId', '')), pedidoId);
      }
      // Y lo segundo es que diga la verdad. Se amarra en las dos direcciones: el "antes"
      // contra lo que el pedido decía y el "después" contra lo que va a decir. Una
      // auditoría que registre otros números no sirve de nada.
      function auditoriaCuadra(a, pedidoId) {
        return a.pedidoId == pedidoId
          && a.despues.totalCent == request.resource.data.totalCent
          && a.despues.envioCobradoCent == request.resource.data.get('envioCobradoCent', 0)
          && a.despues.renglones == request.resource.data.renglones
          && a.despues.cliente == request.resource.data.cliente.nombre
          && a.despues.entrega == request.resource.data.get('entrega', 'local')
          && a.despues.ciudad == request.resource.data.get('ciudad', '')
          && a.antes.totalCent == resource.data.totalCent
          && a.antes.envioCobradoCent == resource.data.get('envioCobradoCent', 0)
          && a.antes.renglones == resource.data.renglones
          && a.antes.cliente == resource.data.get('cliente', {}).get('nombre', '')
          && a.antes.entrega == resource.data.get('entrega', 'local')
          && a.antes.ciudad == resource.data.get('ciudad', '');
      }
      // RIESGO ACEPTADO: no se exige `creadoEn == request.time` en la auditoría. Amarrarlo
      // evitaría que alguien fechara el rastro en otro día, pero si serverTimestamp() no
      // resolviera exactamente a request.time, TODA corrección quedaría bloqueada — y eso
      // no se puede comprobar aquí sin emulador (Java no está instalado). Falsear la fecha
      // exige un cliente manipulado por una de las tres personas del negocio, y el cambio
      // en sí ya no se puede ocultar. Se puede cerrar más adelante, probándolo.
      function rutaAuditoria(opId) {
        return /databases/$(database)/documents/negocios/$(negocio)/pedidosCambios/$(opId);
      }
      function auditoria(opId) { return getAfter(rutaAuditoria(opId)).data; }
      // Las reglas no pueden sumar una lista de renglones de largo variable, así que el
      // cliente guarda ese subtotal y aquí se exige la única igualdad que importa:
      // total = piezas + envío. Sin esto se podía guardar por SDK un pedido cuyo total no
      // tuviera nada que ver con sus renglones, y el detalle, el saldo y "vendiste"
      // decían cosas distintas.
      function cuadraTotal(d) {
        return d.subtotalPiezasCent is int
          && d.subtotalPiezasCent >= 0
          && d.totalCent == d.subtotalPiezasCent + d.get('envioCobradoCent', 0);
      }
      // Lo que se le COBRA a la clienta por el envío (no la guía, que es un gasto). Va
      // dentro del total, así que nunca puede ser mayor.
      //
      // Ya NO se exige que un pedido 'local' lleve envío cero. La primera versión ataba
      // las dos cosas y el mismo 7-sep se vio que está mal: un pedido de Puebla también
      // se manda y también se cobra el envío. "Foráneo" solo dice que hay que restar los
      // días de paquetería a la fecha de entrega; si lleva envío es otra cosa.
      // Las etapas del proceso ("fondo listo", "marco listo"…) son un mapa id → {nombre,
      // hecha} de hasta 12. Cualquier miembro las marca: es trabajo de taller, no dinero.
      // Lo de adentro de cada entrada no se puede revisar aquí (las reglas no recorren
      // mapas); el cliente lo sanea al leer (etapasDe()) y una entrada rara solo se ignora.
      function etapasValidas(d) {
        return d.get('etapas', {}) is map && d.get('etapas', {}).size() <= 12;
      }
      function envioValido(d) {
        return d.get('envioCobradoCent', 0) is int
          && d.get('envioCobradoCent', 0) >= 0
          && d.get('envioCobradoCent', 0) <= d.totalCent
          && d.get('entrega', 'local') in ['local','foraneo'];
      }

      // ── el negocio y sus miembros ─────────────────────────────
      allow read: if esMiembro();

      // Solo la dueña da y quita accesos y cambia roles. Si esto lo pudiera
      // hacer cualquiera, cualquiera podría ascenderse a dueña.
      match /miembros/{uid} {
        allow read:   if esMiembro();
        allow write:  if esDuena();
      }

      // ── pedidos y clientes: los tres capturan ─────────────────
      match /pedidos/{id} {
        allow read:   if esMiembro();
        // El folio ES el id del documento: así dos personas pegando el mismo mensaje de
        // WhatsApp a la vez no pueden crear dos pedidos con el mismo folio — el segundo
        // create choca con el primero. Sin '/' ni rarezas: es un id de Firestore.
        allow create: if esMiembro()
                      && request.resource.data.folio is string
                      && request.resource.data.folio == id
                      && id.matches('^[A-Za-z0-9-]{4,40}$')
                      && request.resource.data.totalCent is int
                      && request.resource.data.totalCent >= 0
                      && request.resource.data.totalCent < 100000000   // mismo tope que montoValido()
                      && request.resource.data.renglones is list
                      && request.resource.data.estado in ['nuevo','proceso','listo','entregado','cancelado']
                      && request.resource.data.get('origen', '') is string
                      && request.resource.data.get('origen', '').size() <= 20
                      && envioValido(request.resource.data)
                      && cuadraTotal(request.resource.data)
                      && etapasValidas(request.resource.data);
        // Dos updates distintos, y la diferencia es si el dinero cambia.
        //
        // (a) El de todos los días —estado, fecha confirmada, notas— no toca el precio:
        //     total, renglones y envío se quedan como estaban.
        // (b) La CORRECCIÓN del pedido (7-sep-2026, pedida por Beto el primer día de uso)
        //     sí cambia precio, pieza y envío, pero solo si en la MISMA tanda se escribe
        //     su documento de auditoría en pedidosCambios. El caso que ganó Codex el
        //     4-sep sigue siendo real —bajar el total deja el pedido sobrepagado— pero ya
        //     no es invisible: queda quién, cuándo, por qué, y cuánto se había pagado.
        //     Sin auditoría en la tanda, existsAfter() sobre ella es false y el update se
        //     rechaza (y si se intentara leer su .data, el acceso a un documento que no
        //     existe también hace fallar la regla: en los dos casos cierra, no abre).
        //
        // El folio y el origen no se tocan en ninguno de los dos: el folio identifica al
        // pedido en voz alta y en papel, y el origen es el dato con el que Marcela mide si
        // la publicidad se paga sola (cambiarlo después reescribe la historia).
        allow update: if esMiembro()
                      && request.resource.data.estado in ['nuevo','proceso','listo','entregado','cancelado']
                      && request.resource.data.folio == resource.data.folio
                      && request.resource.data.get('origen', '') == resource.data.get('origen', '')
                      && envioValido(request.resource.data)
                      && (
                        // (a) el update de siempre: solo estado y fecha confirmada. La
                        // lista blanca es lo que impide que por SDK se cambien el cliente,
                        // las notas, quién lo creó o el propio correccionOpId (con el que
                        // se podría preparar el terreno para una corrección sin rastro).
                        ( request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['estado','fechaComprometida','etapas'])
                          && etapasValidas(request.resource.data)
                          // La lista blanca dice QUÉ se puede tocar, no CÓMO: sin esto se
                          // podía meter un mapa o un texto enorme en la fecha de un pedido
                          // ajeno y dejarlo mostrando "—" para siempre.
                          && ( request.resource.data.fechaComprometida == null
                               || fechaValida(request.resource.data.fechaComprometida) ) )
                        // (b) corrección con rastro, y solo quien opera dinero
                        || ( operaDinero() && correccionAuditada(id)
                             && cuadraTotal(request.resource.data)
                             && request.resource.data.diff(resource.data).affectedKeys()
                                  .hasOnly(['cliente','renglones','totalCent','subtotalPiezasCent',
                                            'envioCobradoCent','entrega','ciudad','correccionOpId']) )
                      );
        // un pedido no se borra: se cancela, para que su historial de cobros siga
        // explicando el dinero que ya entró
        allow delete: if false;
      }
      // ── LIBRO DE CORRECCIONES DE PEDIDO: inmutable ────────────
      // El rastro de cada corrección de precio. Se escribe en la misma tanda que el
      // update del pedido (arriba, correccionAuditada()) y no se edita ni se borra: si se
      // pudiera, la auditoría no auditaría nada.
      match /pedidosCambios/{id} {
        allow read:   if esMiembro();
        allow create: if operaDinero()
                      && request.resource.data.opId == id
                      && request.resource.data.pedidoId is string
                      // El pedido tiene que existir DESDE ANTES (una corrección corrige
                      // algo que ya estaba) y tiene que quedar apuntando a esta auditoría.
                      // Esa reciprocidad es lo que impide sembrar auditorías sueltas para
                      // usarlas después: sin el update del pedido en la misma tanda, este
                      // create se rechaza.
                      && exists(/databases/$(database)/documents/negocios/$(negocio)/pedidos/$(request.resource.data.pedidoId))
                      && getAfter(/databases/$(database)/documents/negocios/$(negocio)/pedidos/$(request.resource.data.pedidoId))
                           .data.get('correccionOpId', '') == id
                      // ...y con el mismo total que dice esta auditoría. Cerrar el círculo
                      // en las dos direcciones impide un rastro que cuente otra historia.
                      && getAfter(/databases/$(database)/documents/negocios/$(negocio)/pedidos/$(request.resource.data.pedidoId))
                           .data.totalCent == request.resource.data.despues.totalCent
                      && request.resource.data.despues.cliente is string
                      && request.resource.data.despues.cliente.size() <= 60
                      && request.resource.data.despues.entrega in ['local','foraneo']
                      && request.resource.data.despues.ciudad is string
                      && request.resource.data.despues.ciudad.size() <= 60
                      && request.resource.data.motivo is string
                      && request.resource.data.motivo.size() > 0
                      && request.resource.data.motivo.size() <= 120
                      && request.resource.data.antes.totalCent is int
                      && request.resource.data.despues.totalCent is int
                      && request.resource.data.despues.totalCent >= 0
                      && request.resource.data.despues.totalCent < 100000000
                      // Es un dato DECLARADO por quien corrige, no verificable: las reglas
                      // no pueden sumar la colección de cobros. Sirve de contexto al leer
                      // el rastro, pero la verdad de lo pagado siempre está en `cobros`.
                      && request.resource.data.pagadoAlCorregir is int
                      && fechaValida(request.resource.data.fecha)
                      && firmadoPorMi('corregidoPor');
        allow update, delete: if false;
      }

      match /clientes/{id} {
        allow read: if esMiembro();
        allow write: if esMiembro();
      }

      // ── LIBRO DE COBROS: inmutable ────────────────────────────
      // Un pago siempre apunta a un pedido que existe y dice en qué cuenta cayó.
      // existsAfter() y no exists(): desde el 7-sep-2026 el anticipo se captura en el alta
      // del pedido y los dos documentos se escriben en la MISMA transacción, así que
      // cuando se evalúa esta regla el pedido todavía no existe "antes" — existe después.
      // Para un cobro posterior el pedido ya está, y existsAfter() también lo ve.
      function pedidoExiste(pid) {
        return pid is string
          && existsAfter(/databases/$(database)/documents/negocios/$(negocio)/pedidos/$(pid));
      }
      // La única corrección posible es revertir un pago COMPLETO, una sola vez: el id de la
      // reversión es 'rev-' + el id del pago, así que no puede haber dos. Debe coincidir
      // en pedido, monto y cuenta con el original. Para corregir $100 que eran $80, se
      // revierte $100 y se registra un pago nuevo de $80: más simple y más auditable que
      // una reversión parcial. La cuenta se valida contra el ORIGINAL, no contra el
      // catálogo: una cuenta que ya se archivó tiene que poder revertirse igual.
      // Separada de reversionValida() para poder cortar ANTES de pedir el original: el &&
      // de reversionValida comprueba `refCobroId is string` primero, y solo si eso pasa
      // llama a esta función (por eso está declarada antes, no después). Con un payload
      // malformado no vale la pena gastar una lectura de Firestore que de todos modos se
      // va a rechazar.
      function reversionCoincideConOriginal(id, d) {
        let orig = get(/databases/$(database)/documents/negocios/$(negocio)/cobros/$(d.refCobroId));
        return id == 'rev-' + d.refCobroId
          && orig.data.tipo == 'pago'
          && orig.data.pedidoId == d.pedidoId
          && orig.data.montoCent == d.montoCent
          && orig.data.cuenta == d.cuenta;
      }
      function reversionValida(id) {
        let d = request.resource.data;
        return d.refCobroId is string && reversionCoincideConOriginal(id, d);
      }
      match /cobros/{id} {
        allow read:   if esMiembro();
        // El prefijo 'rev-' está RESERVADO para reversiones. Antes un PAGO con id 'rev-X'
        // pasaba la condición final con solo `tipo == 'pago'`, y ese documento bloqueaba
        // para siempre la reversión legítima del pago X (el create de la reversión choca
        // contra ese pago, y update está cerrado). Ahora un pago con id 'rev-*' se rechaza
        // y una reversión tiene que, además, pasar reversionValida().
        allow create: if operaDinero()
                      && idempotente(id)
                      && pedidoExiste(request.resource.data.pedidoId)
                      && request.resource.data.tipo in ['pago','reversion']
                      && montoValido(request.resource.data.montoCent)
                      && cuentaValida(request.resource.data.cuenta)
                      && cuentaIdOpcionalValido(request.resource.data)
                      && fechaValida(request.resource.data.fecha)
                      && firmadoPorMi('registradoPor')
                      && ( (request.resource.data.tipo == 'pago' && !id.matches('^rev-.*'))
                        || (request.resource.data.tipo == 'reversion' && reversionValida(id)) );
        allow update, delete: if false;   // se corrige con una reversión, no editando
      }

      // ── MOVIMIENTOS ENTRE CUENTAS: inmutable ──────────────────
      // Mover dinero de una cuenta a otra (Marcela le entrega a Gaby lo del cierre) y
      // ajustar una cuenta al saldo real. Ninguno es venta ni gasto: el negocio no gana ni
      // pierde, el dinero solo cambia de lugar o se reconoce lo que ya había.
      //
      // Un traspaso es UN documento, no dos: si fueran dos escrituras, media falla dejaría
      // el dinero saliendo de una cuenta sin entrar a la otra.
      //
      // El saldo de una cuenta NO se guarda en ningún lado: se deriva de cobros, gastos y
      // esta colección. Por eso aquí basta con que cada movimiento tenga forma válida.
      match /movsCuenta/{id} {
        allow read:   if esMiembro();
        allow create: if operaDinero()
                      && idempotente(id)
                      && firmadoPorMi('registradoPor')
                      && fechaValida(request.resource.data.fecha)
                      && (
                        // mover de una cuenta a otra: dos cuentas distintas y un monto real
                        ( request.resource.data.tipo == 'traspaso'
                          && cuentaIdValido(request.resource.data.deId)
                          && cuentaIdValido(request.resource.data.aId)
                          && request.resource.data.deId != request.resource.data.aId
                          && montoValido(request.resource.data.montoCent)
                          && cuentaValida(request.resource.data.de)
                          && cuentaValida(request.resource.data.a)
                          && request.resource.data.get('nota', '') is string
                          && request.resource.data.get('nota', '').size() <= 60 )
                        // ajustar al saldo real: el delta PUEDE ser negativo (esa es la
                        // gracia), nunca cero, y el motivo es obligatorio — un ajuste sin
                        // explicación es un descuadre escondido.
                        || ( request.resource.data.tipo == 'ajuste'
                          && cuentaIdValido(request.resource.data.cuentaId)
                          && cuentaValida(request.resource.data.cuenta)
                          && request.resource.data.deltaCent is int
                          && request.resource.data.deltaCent != 0
                          && request.resource.data.deltaCent > -100000000
                          && request.resource.data.deltaCent < 100000000
                          && request.resource.data.get('saldoObservadoCent', 0) is int
                          && request.resource.data.motivo is string
                          && request.resource.data.motivo.size() > 0
                          && request.resource.data.motivo.size() <= 80 )
                      );
        // Se corrige con otro movimiento, igual que los cobros: un traspaso al revés, o un
        // ajuste nuevo. Editar o borrar dejaría el saldo sin explicación.
        allow update, delete: if false;
      }

      // ── LIBRO DE INVENTARIO: inmutable ────────────────────────
      match /invMovs/{id} {
        allow read:   if esMiembro();
        allow create: if esMiembro()
                      && idempotente(id)
                      && request.resource.data.materialId is string
                      && request.resource.data.tipo in ['compra','consumo','ajuste']
                      && request.resource.data.cantidad is number
                      && request.resource.data.cantidad != 0
                      && fechaValida(request.resource.data.fecha)
                      && firmadoPorMi('quien');
        allow update, delete: if false;   // se corrige con un movimiento contrario
      }
      match /materiales/{id} {
        allow read: if esMiembro();
        allow create, update: if esMiembro() && request.resource.data.nombre is string;
        // borrar un material dejaría sus movimientos huérfanos y la existencia sin nombre
        allow delete: if false;
      }

      // ── gastos ────────────────────────────────────────────────
      match /gastos/{id} {
        allow read:   if esMiembro();
        allow create: if operaDinero()
                      && idempotente(id)
                      && request.resource.data.concepto is string
                      && montoValido(request.resource.data.montoCent)
                      && cuentaValida(request.resource.data.cuenta)
                      && fechaValida(request.resource.data.fecha)
                      && firmadoPorMi('quien');
        // Los gastos NO son libro inmutable (decisión del CLAUDE.md: solo cobros e
        // invMovs lo son). Pero editar tampoco: la app nunca actualiza un gasto, así que
        // esa puerta estaba abierta sin que nadie la usara. El camino de corrección es
        // que la dueña lo borre, y la app deja constancia en /gastosBorrados antes.
        // La lápida tiene que ir en LA MISMA tanda que el borrado: existsAfter() exige que,
        // al terminar el batch, ya exista su gastosBorrados/{id}. Sin esto alguien podía
        // borrar un gasto sin dejar rastro, escribiendo por SDK en vez de por la app.
        // (La pareja compra↔gasto de invMovs/gastos NO se exige así a propósito: una regla
        // mal escrita ahí bloquearía las capturas de inventario del lunes 7. Riesgo
        // aceptado a conciencia, ya está en CLAUDE.md.)
        allow update: if false;
        allow delete: if esDuena()
                      && existsAfter(/databases/$(database)/documents/negocios/$(negocio)/gastosBorrados/$(id));
      }
      // La lápida de un gasto borrado: qué era, cuánto, de qué fecha y quién lo borró.
      // Borrar un gasto de $500 después del cierre baja "gastaste" $500 aunque el banco no
      // cambió; esto es lo que permite explicar la diferencia después. Solo se crea.
      match /gastosBorrados/{id} {
        allow read:   if esMiembro();
        // Sin lápida no hay borrado: existsAfter() en 'gastos' es false una vez que el
        // batch borra ese documento, así que esta condición exige que el delete vaya en la
        // misma tanda (una lápida suelta, sin su borrado, no tiene sentido).
        allow create: if esDuena()
                      && request.resource.data.gastoId is string
                      && request.resource.data.concepto is string
                      && request.resource.data.montoCent is int
                      && firmadoPorMi('borradoPor')
                      && !existsAfter(/databases/$(database)/documents/negocios/$(negocio)/gastos/$(id));
        allow update, delete: if false;
      }

      // ── pendientes ────────────────────────────────────────────
      match /tareas/{id} {
        allow read: if esMiembro();
        allow create, update: if esMiembro() && request.resource.data.titulo is string;
        allow delete: if esDuena();
      }

      // ── configuración del negocio ─────────────────────────────
      match /config/{doc} {
        allow read: if esMiembro();
        // El catálogo de cuentas de cobro tiene forma esperada: una lista de 1 a 12
        // cuentas. El largo de CADA cuenta (60 bytes) no se puede exigir aquí — las reglas
        // no saben recorrer los elementos de una lista — así que eso lo recorta el cliente
        // (cortarBytes()) antes de guardar; esto solo pone un techo al tamaño de la lista.
        // `cuentas` y `etapas` son los dos catálogos con forma conocida: una lista de 1 a
        // 12. Cualquier otro documento de config se acepta tal cual (hoy no existe ninguno).
        allow create, update: if esDuena()
                              && (!(doc in ['cuentas','etapas'])
                                  || (request.resource.data.lista is list
                                      && request.resource.data.lista.size() >= 1
                                      && request.resource.data.lista.size() <= 12));
        // Borrar `config/etapas` equivale a "volver a las de siempre" (el cliente cae al
        // default cuando el documento no existe). Es decisión de la dueña y es reversible.
        allow delete: if esDuena();
      }

      // ══ LA PÁGINA PÚBLICA ═════════════════════════════════════
      //
      //  Lo único de todo el negocio que el mundo puede leer sin cuenta.
      //  Dos documentos y una razón para cada uno:
      //
      //  · 'publico'  — lo que la página muestra. Se lee sin auth.
      //  · 'borrador' — lo que Gaby está escribiendo. NO se lee sin auth:
      //    una errata a medias no debe verse en internet.
      //
      //  El permiso es `get`, no `list`: nadie puede pedir "dame todos los
      //  documentos de sitio" y toparse con el borrador de rebote.
      //
      //  Los textos viajan como UN string de JSON, no como un mapa. No es
      //  capricho: las reglas de Firestore no saben recorrer los valores de
      //  un mapa, pero sí saben medir un string. Así el tope de tamaño es
      //  real y no un adorno.
      //
      //  Ojo con lo que estas reglas NO pueden hacer: quien tenga cuenta de
      //  dueña o socia escribe el texto que quiera, y ese texto sale en una
      //  página pública. La defensa contra un <script> ahí es que la página
      //  arma NODOS del DOM y nunca asigna innerHTML — está en el módulo
      //  "CONTENIDO EDITABLE" de pagina-web/index.html. Si alguien cambia eso
      //  por innerHTML, esta regla deja de alcanzar.
      function editaSitio() {
        return esMiembro() && (miRol() == 'duena' || miRol() == 'socia');
      }
      function contenidoValido() {
        let d = request.resource.data;
        return d.keys().hasOnly(['textosJson','imagenesJson','galeriaJson','whatsapp',
                                 'revision','actualizadoPor','actualizadoEn'])
          && d.textosJson   is string && d.textosJson.size()   <= 40000
          && d.imagenesJson is string && d.imagenesJson.size() <= 8000
          && d.galeriaJson  is string && d.galeriaJson.size()  <= 12000
          && d.whatsapp     is string && d.whatsapp.size()     <= 15
          && d.revision is int && d.revision >= 0
          && d.actualizadoPor == request.auth.uid   // no se firma a nombre de otra
          && d.actualizadoEn == request.time;       // ni se antedata
      }
      match /sitio/{doc} {
        allow get:   if doc == 'publico' || esMiembro();
        allow list:  if esMiembro();
        // La revisión tiene que AVANZAR en cada escritura. Es el freno contra dos
        // personas editando a la vez: el editor lee la revisión del servidor dentro de
        // una transacción y solo escribe revisión+1; si alguien más ya avanzó la
        // revisión mientras tanto, la transacción del cliente reintenta con el dato
        // fresco en vez de pisarlo. Esta regla es la frontera real — el cliente podría
        // tener un bug, pero sin esto un `setDoc` directo por SDK siempre podría pisar
        // sin que Firestore se queje.
        allow create: if editaSitio() && doc in ['publico','borrador'] && contenidoValido();
        allow update: if editaSitio() && doc in ['publico','borrador'] && contenidoValido()
                      && request.resource.data.revision > resource.data.revision;
      }

      // Las fotos que sube Gaby, una por documento y en BYTES, no en base64
      // (base64 pesa 33% más y aquí el ancho de banda gratis es finito).
      //
      // Los ids son fijos, foto-00 a foto-19: es la única forma de que las
      // reglas puedan poner un techo al número de fotos, porque no saben
      // contar documentos de una colección.
      //
      // `publicada` nace en false SIEMPRE (una foto recién subida o reemplazada
      // no ha salido a internet todavía) y solo pasa a true por la tanda que
      // hace publicar() en el editor, DESPUÉS de que el documento público ya se
      // escribió con éxito. `subidoEn == request.time` no puede sobrevivir a esa
      // segunda escritura (solo cambia `publicada`, no se reenvía la foto entera),
      // así que esa tanda se valida aparte con `soloCambiaPublicada()`.
      function fotoValida(id) {
        let d = request.resource.data;
        return id.matches('^foto-(0[0-9]|1[0-9])$')
          && d.keys().hasOnly(['imagen','mime','w','h','subidoPor','subidoEn','publicada'])
          && d.imagen is bytes && d.imagen.size() > 0 && d.imagen.size() <= 286720  // 280 KB
          && d.mime in ['image/jpeg','image/webp']
          && d.w is int && d.w > 0 && d.w <= 4000
          && d.h is int && d.h > 0 && d.h <= 4000
          && d.subidoPor == request.auth.uid
          && d.subidoEn == request.time
          && d.publicada == false;
      }
      function soloCambiaPublicada() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['publicada'])
          && request.resource.data.publicada is bool;
      }
      match /sitioFotos/{id} {
        // De una en una y por su id, y solo si ya está publicada o si quien pregunta
        // es del negocio: el borrador no se ve desde fuera, y de paso nadie puede
        // adivinar un id (foto-00..foto-19) para ver una foto que Gaby no ha publicado.
        allow get:    if id.matches('^foto-(0[0-9]|1[0-9])$')
                      && (resource.data.get('publicada', false) == true || esMiembro());
        allow list:   if esMiembro();
        allow create, update: if editaSitio() && (fotoValida(id) || soloCambiaPublicada());
        allow delete: if editaSitio();
      }
    }

    // ── riesgos de sitio/sitioFotos que se aceptan a conciencia ──
    // 1) Estas reglas no pueden comprobar que `bytes` sea de verdad una imagen (no hay
    //    forma de leer el contenido del archivo desde una regla). La defensa contra un
    //    XSS por ahí es que `mime` solo acepta jpeg/webp: un SVG o un HTML disfrazado no
    //    entra, aunque los bytes en sí no se validen.
    // 2) `editaSitio()` (dueña y socia) podría, escribiendo por SDK en vez de usar el
    //    editor, subir fotos en ráfaga y agotar la cuota gratis del plan Spark. Se acepta
    //    porque solo dos personas de confianza tienen ese permiso.

    // ── nada fuera de un negocio ───────────────────────────────
    // Firestore ya niega por defecto; esto queda explícito como recordatorio
    // de que aquí NUNCA debe aparecer un `if request.auth != null` general.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
